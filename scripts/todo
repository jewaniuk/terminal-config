#!/usr/bin/env bash

# compact read-only view of the task board (github project #4, repo jewaniuk/tasks)
# usage: todo next | inbox | projects | project <n>
# output is a table with a header row and aligned columns

owner="jewaniuk"
repo="tasks"
project=4

usage() {
    cat >&2 <<'EOF'
usage: todo <command>
  next          next or doing tasks in active projects, by category and project priority
  inbox         tasks waiting to be triaged
  projects      open projects by category and priority, with their doing and next steps
  project <n>   one project's steps in order (n is the issue number from `todo projects`)
EOF
    exit 1
}

# print tab separated rows (header first) as an aligned table
table() {
    column -t -s $'\t'
}

# board fields of every item as a json map {"number": {status, priority, category, kind, effort, due}}
board_fields() {
    gh project item-list "$project" --owner "$owner" --limit 500 --format json --jq \
        '[.items[] | {key: (.content.number | tostring),
          value: {status: (.status // "-"), priority: (.priority // "-"), category: (.category // "-"),
                  kind: (.kind // "-"), effort: (.effort // "-"), due: (.due // "-")}}] | from_entries'
}

# every open issue as a json array of {number, title, parent, labels}, following pagination
open_issues() {
    gh api graphql --paginate -f query='
        query($owner: String!, $repo: String!, $endCursor: String) {
            repository(owner: $owner, name: $repo) {
                issues(first: 100, states: OPEN, after: $endCursor) {
                    pageInfo { hasNextPage endCursor }
                    nodes { number title parent { number title } labels(first: 10) { nodes { name } } }
                }
            }
        }' -f owner="$owner" -f repo="$repo" --jq '.data.repository.issues.nodes[]' | jq -s '.'
}

# tasks that are next or doing in projects that are next or doing, one table per category,
# ordered by project priority, then doing before next
list_next() {
    local fields rows cat
    fields=$(board_fields)
    rows=$(open_issues | jq -r --argjson f "$fields" '
        def rank: {"!!!": 0, "!!": 1, "!": 2, "-": 3}[.] // 4;
        def active: test("^(next|doing)$");
        [.[] | select(.parent != null)
         | select([.labels.nodes[].name] | index("project") | not)
         | ($f[.number | tostring]) as $t
         | ($f[.parent.number | tostring]) as $p
         | select($t and $p and ($t.status | active) and ($p.status | active))
         | {cat: $p.category, proj: .parent.title, pri: $p.priority, n: .number, t: $t, title: .title}]
        | sort_by([.cat, (.pri | rank), (if .t.status == "doing" then 0 else 1 end), .proj])
        | .[] | [.cat, .proj, .pri, ("#" + (.n | tostring)), .t.status, .t.kind, .t.effort, .t.due, .title] | @tsv')
    [ -n "$rows" ] || return 0
    for cat in $(cut -f1 <<<"$rows" | uniq); do
        echo "$cat"
        {
            printf 'PROJECT\tPRI\t#\tSTATUS\tKIND\tEFFORT\tDUE\tTITLE\n'
            awk -F '\t' -v c="$cat" '$1 == c' <<<"$rows" | cut -f2-
        } | table
        echo
    done
}

# tasks waiting to be triaged
list_inbox() {
    {
        printf '#\tTITLE\n'
        gh project item-list "$project" --owner "$owner" --limit 500 --format json --jq \
            '.items[] | select(.status == "inbox") | [("#" + (.content.number | tostring)), .title] | @tsv'
    } | table
}

# list open projects (issues labelled project) by category and priority, with their doing and next sub-issues
list_projects() {
    local fields
    fields=$(board_fields)
    {
        printf 'CATEGORY\tPRI\t#\tSTATUS\tTITLE\tDOING\tNEXT\n'
        gh api graphql -f query='
            query($owner: String!, $repo: String!) {
                repository(owner: $owner, name: $repo) {
                    issues(first: 100, states: OPEN, labels: ["project"]) {
                        nodes { number title subIssues(first: 100) { nodes { number title state } } }
                    }
                }
            }' -f owner="$owner" -f repo="$repo" --jq '.data.repository.issues.nodes' |
            jq -r --argjson f "$fields" '
                def rank: {"!!!": 0, "!!": 1, "!": 2, "-": 3}[.] // 4;
                def step($s): [.subIssues.nodes[] | select($f[.number | tostring].status == $s)][0]
                    | if . then "#" + (.number | tostring) + " " + .title else "-" end;
                [.[] | ($f[.number | tostring] // {}) as $p
                 | {cat: ($p.category // "-"), pri: ($p.priority // "-"), n: .number, status: ($p.status // "-"),
                    title: .title, doing: step("doing"), next: step("next")}]
                | sort_by([.cat, (.pri | rank), .title])
                | .[] | [.cat, .pri, ("#" + (.n | tostring)), .status, .title, .doing, .next] | @tsv'
    } | table
}

# list a project's sub-issues in chain order, with board status and open blockers
list_project() {
    local number="$1"
    local fields
    fields=$(board_fields)
    gh api graphql -f query='
        query($owner: String!, $repo: String!, $number: Int!) {
            repository(owner: $owner, name: $repo) {
                issue(number: $number) {
                    title
                    subIssues(first: 50) {
                        nodes {
                            number title state
                            blockedBy(first: 10) { nodes { number state } }
                        }
                    }
                }
            }
        }' -f owner="$owner" -f repo="$repo" -F number="$number" --jq '.data.repository.issue' |
        jq -r --argjson f "$fields" '
            # order sub-issues by the blocked-by chain: emit the first one whose blockers are all emitted
            def chain_order:
                . as $all
                | ([$all[].number]) as $nums
                | reduce range(0; $all | length) as $i ({out: [], done: []};
                    . as $s
                    | [$all[] | select(.number as $n | $s.done | index($n) | not)] as $left
                    | ([$left[] | select([.blockedBy.nodes[].number | select(. as $b | $nums | index($b)) | select(. as $b | $s.done | index($b) | not)] | length == 0)] + $left | .[0]) as $pick
                    | .out += [$pick] | .done += [$pick.number])
                | .out[];
            "project: " + .title,
            "",
            "#\tSTATUS\tTITLE\tBLOCKED BY",
            (.subIssues.nodes | chain_order |
                [("#" + (.number | tostring)),
                 (if .state == "CLOSED" then "closed" else ($f[.number | tostring].status // "-") end),
                 .title,
                 (([.blockedBy.nodes[] | select(.state == "OPEN") | "#" + (.number | tostring)]) | if length > 0 then join(", ") else "-" end)] | @tsv)' |
        {
            # first two lines are the plain heading, the rest is the table
            read -r heading
            read -r blank
            echo "$heading"
            echo "$blank"
            table
        }
}

case "$1" in
    next) list_next ;;
    inbox) list_inbox ;;
    projects) list_projects ;;
    project)
        [ -n "$2" ] || usage
        list_project "$2"
        ;;
    *) usage ;;
esac
