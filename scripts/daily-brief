#!/usr/bin/env bash

# build the daily brief and write it into the pinned "Daily Brief" issue in jewaniuk/tasks
# usage: daily-brief [--print]   (--print shows the brief instead of updating the issue)
# runs unattended from launchd, so it sets its own PATH and loads secrets itself

export PATH="/opt/homebrew/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
# shellcheck disable=SC1090
[ -f ~/.config/secrets.zsh ] && source ~/.config/secrets.zsh

owner="jewaniuk"
repo="tasks"
project=4

if vdirsyncer sync >/dev/null 2>&1; then
    sync_note=""
else
    sync_note="_calendar sync failed, the agenda may be out of date_"
fi

# tasks due or targeted within 7 days (or overdue), not done, earliest first
due_soon() {
    gh project item-list "$project" --owner "$owner" --limit 200 --format json --jq '
        (now | localtime | strftime("%Y-%m-%d")) as $today
        | (now + 7 * 86400 | localtime | strftime("%Y-%m-%d")) as $cutoff
        | [.items[]
            | select(.status != "done")
            | select(((.due // "9999") <= $cutoff) or ((.target // "9999") <= $cutoff))]
        | sort_by([(.due // "9999"), (.target // "9999")])
        | .[]
        | [("#" + (.content.number | tostring)), .status, (.priority // "-"), (.due // "-"), (.target // "-"),
           (if ((.due // .target) < $today) then "OVERDUE " else "" end) + .title]
        | @tsv' | {
        printf '#\tSTATUS\tPRI\tDUE\tTARGET\tTITLE\n'
        cat
    } | column -t -s $'\t'
}

# print a section body in a code block, or a placeholder when only the header row is present
block() {
    local text="$1"
    if [ "$(printf '%s\n' "$text" | wc -l)" -le 1 ]; then
        echo "nothing"
    else
        printf '```\n%s\n```\n' "$text"
    fi
}

brief() {
    echo "**$(date '+%A %Y-%m-%d')** · generated $(date '+%H:%M')"
    [ -n "$sync_note" ] && echo && echo "$sync_note"
    echo
    echo "## Agenda, today and tomorrow"
    echo
    printf '```\n%s\n```\n' "$(khal list today 2d 2>&1 | grep -v '^warning')"
    echo
    echo "## Next and doing"
    echo
    block "$(todo next)"
    echo
    echo "## Due or targeted within 7 days"
    echo
    block "$(due_soon)"
    echo
    echo "## Inbox"
    echo
    block "$(todo inbox)"
}

if [ "$1" = "--print" ]; then
    brief
else
    number=$(gh issue list --repo "$owner/$repo" --label brief --state open --json number --jq '.[0].number')
    brief | gh issue edit "$number" --repo "$owner/$repo" --body-file -
fi
