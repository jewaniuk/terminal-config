{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "host",
    "os",
    "kernel",
    "display",
    "gpu",
    "cpu",
    {
        "type": "cpuusage",
        "percent": { "type": 3 }
    },
    {
        "type": "memory",
        "percent": { "type": 3 }
    },
    {
        "type": "swap",
        "percent": { "type": 3 }
    },
    {
        "type": "disk",
        "percent": { "type": 3 }
    },
    "localip",
    "shell",
    "wm",
    "terminal",
    "terminalfont",
    "editor",
    "packages",
    "break",
    "colors"
  ]
}
