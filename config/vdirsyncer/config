# two-way sync between icloud caldav and local .ics files that khal reads
# credentials come from ICLOUD_USER and ICLOUD_APP_PASSWORD in ~/.config/secrets.zsh
# first run, after install.sh has linked this file: vdirsyncer discover icloud && vdirsyncer sync && vdirsyncer metasync
# (metasync pulls the calendar names that khal needs for default_calendar)

[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair icloud]
a = "icloud_local"
b = "icloud_remote"
# explicit list so the empty Reminders calendar is skipped (collection ids, not display names)
# ids in order: home, work, Teaching, Shopping, School, Extracurriculars
collections = ["home", "work", "0A4FE029-4519-4ABA-8933-CA3A7FD09B03", "44AB1E37-BDAA-491D-965E-D7FAA744F4E5", "479FB048-BC75-4D76-B7E1-C22A1F301598", "6F9FB66E-23A8-43FD-BFBD-73E69623AB57"]
metadata = ["color", "displayname"]
conflict_resolution = "b wins"

[storage icloud_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/"
fileext = ".ics"

[storage icloud_remote]
type = "caldav"
url = "https://caldav.icloud.com/"
username.fetch = ["command", "printenv", "ICLOUD_USER"]
password.fetch = ["command", "printenv", "ICLOUD_APP_PASSWORD"]
# events only, skips reminders
item_types = ["VEVENT"]
